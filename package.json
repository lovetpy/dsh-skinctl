{
  "name": "dsh-skinctl",
  "description": "Lightweight skin manager for the dsh web GUI: scans installed skins at runtime (no hardcoded list) and switches the active one via profile patch + config HMR.",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovetpy/dsh-skinctl.git"
  },
  "homepage": "https://github.com/lovetpy/dsh-skinctl#readme",
  "bugs": {
    "url": "https://github.com/lovetpy/dsh-skinctl/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "theme",
    "switcher"
  ],
  "scripts": {}
}
